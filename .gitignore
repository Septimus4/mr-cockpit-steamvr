# uv keeps its python and cache inside the project: this machine's shells run in an
# MSIX container where AppData writes are virtualised, which breaks the default
# locations. See docs/PLAN.md.
.venv/
.uvcache/
.uvpython/

__pycache__/
*.pyc

# Camera captures are large and machine-specific. The synthetic one is regenerated by
# `python scripts/trace_cutout.py demo`.
captures/

# archive/ IS committed: the .npz files are real measurement data that cannot be
# reproduced, and the images are evidence for findings the docs cite.
